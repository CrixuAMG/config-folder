#!/usr/bin/env python3
import subprocess, sys, re, shlex

commit_hash = sys.argv[1] if len(sys.argv) > 1 else "HEAD"

diff = subprocess.run(
    ["git", "show", "--no-notes", "--format=", commit_hash],
    capture_output=True, text=True
).stdout or ""

if not diff.strip():
    empty_tree = subprocess.run(
        ["git", "hash-object", "-t", "tree", "/dev/null"],
        capture_output=True, text=True
    ).stdout.strip()
    diff = subprocess.run(
        ["git", "diff-tree", "--no-commit-id", "-r", "--patch",
         empty_tree, commit_hash],
        capture_output=True, text=True
    ).stdout or ""

if not diff.strip():
    print("No diff found for commit", file=sys.stderr)
    sys.exit(1)

branch = subprocess.run(
    ["git", "branch", "--show-current"], capture_output=True, text=True
).stdout.strip()
m = re.search(r"[A-Z]+-\d+", branch)
prefix = m.group(0) if m else None

if not prefix:
    orig_msg = subprocess.run(
        ["git", "log", "--format=%s", "-1", commit_hash],
        capture_output=True, text=True
    ).stdout.strip()
    m2 = re.match(r"([A-Z]+-\d+)", orig_msg)
    if m2:
        prefix = m2.group(1)

diff_trunc = "\n".join(diff.split("\n")[:200])

files_changed = len([
    l for l in subprocess.run(
        ["git", "show", "--name-only", "--format=", commit_hash],
        capture_output=True, text=True
    ).stdout.splitlines() if l.strip()
])
large = files_changed > 3 or len(diff.splitlines()) > 100

if large:
    prompt = (
        "Generate a conventional git commit message for these changes:\n\n"
        f"{diff_trunc}\n\n"
        "Output the commit subject on line 1 (max 72 chars, conventional commit "
        "style), then a blank line, then a body with bullet points (- prefix) "
        "explaining the key changes, each line wrapped at 72 chars. "
        "Output ONLY the message text, no code fences, no extra commentary. "
        "Write a normal conventional commit; do not use caveman or terse style."
    )
else:
    prompt = (
        "Generate a conventional git commit message for these changes:\n\n"
        f"{diff_trunc}\n\n"
        "Output ONLY the commit subject line (max 72 chars), nothing else. "
        "Write a normal conventional commit; do not use caveman or terse style."
    )

if sys.platform == "darwin":
    script_cmd = ["script", "-q", "/dev/null", "opencode", "run", prompt]
else:
    script_cmd = ["script", "-q", "-c", f"opencode run {shlex.quote(prompt)}", "/dev/null"]

result = subprocess.run(script_cmd, capture_output=True, text=True, timeout=60)

ansi_re = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')
osc_re = re.compile(r'\x1b\].*?(?:\x1b\\|\x07)')
caret_re = re.compile(r'^\^[A-Z@\[\]\\^_?]+$')
clean_lines = []
for raw in result.stdout.splitlines():
    line = osc_re.sub('', raw)
    line = ansi_re.sub('', line)
    line = ''.join(ch for ch in line if ch.isprintable() or ch.isspace()).rstrip()
    stripped = line.strip()
    if not stripped or stripped.startswith(">") or caret_re.match(stripped):
        continue
    clean_lines.append(line.replace('`', ''))

if not clean_lines:
    print("Failed to generate message", file=sys.stderr)
    sys.exit(1)

subject = clean_lines[0].strip()
header = f"{prefix} {subject}" if prefix else subject
print(header)

if large and len(clean_lines) > 1:
    body_lines = clean_lines[1:]
    while body_lines and not body_lines[0].strip():
        body_lines.pop(0)
    if body_lines:
        print()
        print("\n".join(body_lines))
