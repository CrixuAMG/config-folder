# Global gitignore: patterns ignored in every repository on this machine.
#
# Git >= 2.32 reads this file automatically from $XDG_CONFIG_HOME/git/ignore
# (falling back to ~/.config/git/ignore), so no symlink is needed for it.
# A core.excludesFile set in a config file overrides this default.

